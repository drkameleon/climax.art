;---------------------------
; Types
;---------------------------

define :option [
    init: method [s :string][
        \name:    s
        \cli:     (suffix? s "?")? -> chop s -> s
        \pred?:   suffix? s "?"
        \alias:   ø
        \default: ø
        \types:   (\pred?)? -> @[:logical] -> []
        \info:    ""
    ]

    fetchFrom: method [src :dictionary][
        if in? \cli keys src -> return src\[\cli]
        if and? [not? null? \alias][in? \alias keys src] ->
            return src\[\alias]
        return ø
    ]
]

define :command [
    init: method [
        info :string
        args :block
        opts :dictionary
        body :block
    ][
        \info: info
        \args: args
        \opts: opts
        \body: body
        \subs: ø
    ]

    run: method [opts :dictionary  rest :block  names :block  values :block][
        wrapperArgs: @['opts 'rest]
        wrapperVals: @[opts rest]

        loop.with:'i names 'argName [
            wrapperArgs: append wrapperArgs argName
            wrapperVals: append wrapperVals values\[i]
        ]

        fn: function wrapperArgs \body
        call fn wrapperVals
    ]
]

define :cli [
    init: method [knownCommands :block][
        \globals: #[]
        \command: ø
        \options: #[]
        \params:  []
        \rest:    []

        tokens: (attr 'using) ?? arg
        if string? tokens -> tokens: split.words tokens

        \parse tokens knownCommands
    ]

    help?: method [][
        ks: keys \globals
        or? [in? "help" ks][in? "h" ks]
    ]

    version?: method [][
        ks: keys \globals
        or? [in? "version" ks][in? "V" ks]
    ]

    helpFor?: method [][
        ks: keys \options
        or? [in? "help" ks][in? "h" ks]
    ]

    parseFlag: method [token :string][
        clean: token | drop.times: (prefix? token "--")? -> 2 -> 1

        idxColon: index clean ":"
        idxEqual: index clean "="

        if and? [null? idxColon][null? idxEqual] ->
            return #[name: clean value: true]

        sep: ø
        if null? idxColon -> sep: idxEqual
        if null? idxEqual -> sep: idxColon
        if null? sep      -> sep: min @[idxColon idxEqual]

        return #[
            name:  slice clean 0 (dec sep)
            value: slice clean (inc sep) (dec size clean)
        ]
    ]

    parse: method [tokens :block  knownCommands :block][
        i: 0
        foundCommand?: false

        while [i < size tokens][
            token: tokens\[i]

            case token [
                "--" [
                    i: i + 1
                    while [i < size tokens][
                        \rest: append \rest tokens\[i]
                        i: i + 1
                    ]
                ]
                any [
                    (and? [prefix? token "-"][token <> "-"])? [
                        flag: \parseFlag token
                        val: flag\value
                        if string? val [
                            if numeric? val -> val: to :integer val
                        ]
                        (foundCommand?)?
                            -> \options\[flag\name]: val
                            -> \globals\[flag\name]: val
                    ][
                        if and? [not? foundCommand?][in? token knownCommands][
                            \command: token
                            foundCommand?: true
                        ]
                        if or? [foundCommand?][not? in? token knownCommands] ->
                            if token <> \command ->
                                \params: append \params token
                    ]
                ]
            ]

            i: i + 1
        ]
    ]
]

;---------------------------
; Help templates
;---------------------------

import ./"templates/plain"!
import ./"templates/default"!

;---------------------------
; The main module
;---------------------------

export module [
    ;---------------------------
    ; Private helpers
    ;---------------------------

    parseOptionSpec: function [block :block][
        ; forced order per row:
        ;   <name>[?]  ['alias]  [<default>]  [:type ...]  ["description"]
        specs:   #[]
        items:   new block
        cur:     ø
        sawType: false

        loop items 'tok [
            case type tok [
                :word [
                    if not? null? cur [ specs\[cur\name]: cur ]
                    cur: to :option @[to :string tok]!
                    sawType: cur\pred?
                ]
                :literal [
                    if not? null? cur -> cur\alias: to :string tok
                ]
                :type [
                    if not? null? cur [
                        cur\types: append cur\types tok
                        sawType: true
                    ]
                ]
                :string [
                    if not? null? cur [
                        if and? [not? sawType][null? cur\default] -> cur\default: tok
                        if and? [sawType][empty? cur\info]        -> cur\info: tok
                    ]
                ]
                any [
                    if not? null? cur [
                        if null? cur\default -> cur\default: tok
                    ]
                ]
            ]
        ]

        if not? null? cur -> specs\[cur\name]: cur
        return specs
    ]

    coerceValue: function [val  types :block][
        if empty? types -> return val
        if not? string? val [
            loop types 't [
                if is? t val -> return val
            ]
            return val
        ]
        loop types 't [
            if t = :string -> return val
            converted: ø
            try [ converted: to t val ]
            if not? null? converted -> return converted
        ]
        return val
    ]

    extractArgNames: function [argBlock :block] ->
        select argBlock 'tok -> word? tok

    argTypes: function [argBlock :block  argName :word][
        ret: []
        seen?: false
        done?: false
        loop argBlock 'tok [
            if not? done? [
                if word? tok [
                    if and? [seen?][tok <> argName] -> done?: true
                    if tok = argName -> seen?: true
                ]
                if and? [seen?][:type = type tok] -> 'ret ++ tok
            ]
        ]
        return ret
    ]

    resolveOpt: method [spec :option  provided][
        if not? null? provided     -> return \coerceValue provided spec\types
        if not? null? spec\default -> return spec\default
        if spec\pred?              -> return false
        return ø
    ]

    buildOpts: method [cmdOpts :dictionary  globalSpec :dictionary  parsedGlobals :dictionary  parsedOptions :dictionary][
        ret: #[]
        mergedSrc: #[]
        loop parsedGlobals [k v] -> mergedSrc\[k]: v
        loop parsedOptions [k v] -> mergedSrc\[k]: v

        loop @[globalSpec cmdOpts] 'specs [
            loop specs [name s][!
                v: \resolveOpt s (s\fetchFrom mergedSrc)
                ret\[name]: v
                if not? null? s\alias -> ret\[s\alias]: v
            ]
        ]
        return ret
    ]

    dispatchLeaf: method [cmd :command  params :block  rest :block  parsedGlobals :dictionary  parsedOptions :dictionary  globalSpec :dictionary][
        opts: \buildOpts cmd\opts globalSpec parsedGlobals parsedOptions
        names: \extractArgNames cmd\args

        values: []
        loop.with:'i names 'argName [
            val: (i < size params)? -> params\[i] -> ø
            if not? null? val [
                ts: \argTypes cmd\args argName
                val: \coerceValue val ts
            ]
            values: append values val
        ]

        cmd\run opts rest names values
    ]

    mergeSpecs: function [a :dictionary  b :dictionary][
        extend a b
    ]

    displayLabel: function [pathSoFar :block][
        appName: (script\name) ?? "app"

        unless empty? pathSoFar -> 
            'appName ++ " " ++ join.with:" " pathSoFar
        
        return appName
    ]

    visibleCommands: function [commands :dictionary][
        ret: #[]
        loop commands [name cmd] ->
            if name <> "default" -> 
                ret\[name]: cmd
        return ret
    ]

    dispatchNested: method [cmd :command  pathSoFar :block  params :block  parsed :cli  globalSpec :dictionary][
        unless null? cmd\subs [
            nextGlobals: \mergeSpecs globalSpec cmd\opts

            unless empty? params [
                nextName: params\0
                if in? nextName keys cmd\subs [
                    childParams: (1 < size params)? -> slice params 1 (dec size params) 
                                                    -> []

                    \dispatchNested cmd\subs\[nextName] pathSoFar ++ nextName childParams parsed nextGlobals
                    return ø
                ]
                if in? "default" keys cmd\subs [
                    \dispatchNested cmd\subs\default pathSoFar params parsed nextGlobals
                    return ø
                ]
                label: \displayLabel pathSoFar
                print ~"|label|: unknown sub-command `|nextName|`"
                \renderGroupHelp pathSoFar cmd nextGlobals
                return ø
            ]

            if parsed\helpFor? [
                \renderGroupHelp pathSoFar cmd nextGlobals
                return ø
            ]

            if in? "default" keys cmd\subs [
                \dispatchNested cmd\subs\default pathSoFar params parsed nextGlobals
                return ø
            ]

            \renderGroupHelp pathSoFar cmd nextGlobals
            return ø
        ]

        if parsed\helpFor? [
            \renderCommandHelp pathSoFar cmd globalSpec
            return ø
        ]

        names: \extractArgNames cmd\args
        missing: []
        loop.with:'i names 'argName [
            if i >= size params [
                ts: \argTypes cmd\args argName
                unless in? :null ts -> 
                    missing: append missing argName
            ]
        ]
        unless empty? missing [
            miss: missing | map 'm -> ~"<|to :string m|>"
                          | join.with: " "

            label: \displayLabel pathSoFar
            print ~"|label|: missing required argument(s): |miss|"
            return ø
        ]

        \dispatchLeaf cmd params parsed\rest parsed\globals parsed\options globalSpec
    ]

    ;---------------------------
    ; Template selection
    ;---------------------------

    loadBundled: function [name :string][
        do ~"to :|name|Template []"
    ]

    pickTemplate: function [][
        tplAttr: attr 'template
        if null? tplAttr -> return \loadBundled "default"
        name: to :string tplAttr
        \loadBundled name
    ]

    ;---------------------------
    ; Data builders for templates
    ;---------------------------

    buildOptionEntries: function [specs :dictionary][
        ret: []
        loop specs [k s][!
            long: (s\pred?)? -> "--" ++ s\cli -> "--" ++ s\name ++ "=VALUE"
            flag: (null? s\alias)?
                -> "    " ++ long
                -> "-" ++ s\alias ++ ", " ++ long
            entry: #[
                flag:        flag
                info:        s\info
                default:     (null? s\default)? -> ø -> to :string s\default
                isPredicate: s\pred?
            ]
            ret: append ret entry
        ]
        return ret
    ]

    buildSubcommandEntries: function [visible :dictionary][
        ret: []
        loop visible [name cmd][!
            entry: #[
                name:    name
                info:    cmd\info
                isGroup: not? null? cmd\subs
            ]
            ret: append ret entry
        ]
        return ret
    ]

    buildArgEntries: function [argBlock :block][
        names: \extractArgNames argBlock
        ret: []
        loop names 'a [
            ts: \argTypes argBlock a
            entry: #[
                name:     to :string a
                required: not? in? :null ts
            ]
            ret: append ret entry
        ]
        return ret
    ]

    defaultMeta: function [commands :dictionary][
        if not? in? "default" keys commands -> return @[ø ø]
        def: commands\default
        @[\buildArgEntries def\args  \buildOptionEntries def\opts]
    ]

    ;---------------------------
    ; Help rendering (delegates to template)
    ;---------------------------

    renderHelp: method [globalSpec :dictionary  commands :dictionary][
        info: script
        appName: info\name ?? "app"
        appDesc: info\description ?? ""

        visible: \visibleCommands commands
        defMeta: \defaultMeta commands

        data: #[
            kind:           'root
            appName:        appName
            appDesc:        appDesc
            globalOptions:  \buildOptionEntries globalSpec
            subcommands:    \buildSubcommandEntries visible
            defaultArgs:    defMeta\0
            defaultOptions: defMeta\1
        ]
        tpl: \pickTemplate!
        tpl\renderRoot data
    ]

    renderGroupHelp: method [pathSoFar :block  cmd :command  globalSpec :dictionary][
        visible: \visibleCommands cmd\subs
        defMeta: \defaultMeta cmd\subs

        data: #[
            kind:           'group
            appName:        (script\name) ?? "app"
            pathLabel:      \displayLabel pathSoFar
            info:           cmd\info
            options:        \buildOptionEntries cmd\opts
            globalOptions:  \buildOptionEntries globalSpec
            subcommands:    \buildSubcommandEntries visible
            defaultArgs:    defMeta\0
            defaultOptions: defMeta\1
        ]
        tpl: \pickTemplate!
        tpl\renderGroup data
    ]

    renderCommandHelp: method [pathSoFar :block  cmd :command  globalSpec :dictionary][
        data: #[
            kind:           'command
            appName:        (script\name) ?? "app"
            pathLabel:      \displayLabel pathSoFar
            info:           cmd\info
            args:           \buildArgEntries cmd\args
            options:        \buildOptionEntries cmd\opts
            globalOptions:  \buildOptionEntries globalSpec
        ]
        tpl: \pickTemplate!
        tpl\renderCommand data
    ]

    harvestCommands: function [decls :block][
        ret: #[]
        ctx: dictionary decls
        loop ctx [name val][
            if is? :command val -> ret\[name]: val
        ]
        return ret
    ]

    ;---------------------------
    ; Public API
    ;---------------------------

    climax: method.public [decls :block][
        ;; description: « build and dispatch a CLI from the given declarations
        ;; options: [
        ;;     with: :block « global options (row grammar)
        ;; ]
        withBlock: (attr 'with) ?? []
        globalSpec: \parseOptionSpec withBlock

        command: function [desc :string  args :block  body :block][
            optSpec: \parseOptionSpec ((attr 'with) ?? [])
            to :command @[desc args optSpec body]!
        ]

        group: function [desc :string  decls :block][
            optSpec: \parseOptionSpec ((attr 'with) ?? [])
            subs:    \harvestCommands decls
            cmd: to :command @[desc [] optSpec []]!
            cmd\subs: subs
            cmd
        ]

        commands: \harvestCommands decls

        parsed: to :cli @[keys commands]!

        if parsed\version? [
            print (script\version ?? "?")
            return ø
        ]

        hasDefault?: in? "default" keys commands

        if and? [parsed\help?][null? parsed\command] [
            \renderHelp globalSpec commands
            return ø
        ]
        
        unless cmdName: <= parsed\command [
            (hasDefault?) ? -> \dispatchNested commands\default [] parsed\params parsed globalSpec
                            -> \renderHelp globalSpec commands

            return ø
        ]

        unless in? cmdName keys commands [
            (hasDefault?) ? [
                \dispatchNested commands\default [] parsed\params parsed globalSpec
            ][
                print ~"climax: unknown command `|cmdName|`"
                \renderHelp globalSpec commands
            ]
            return ø
        ]

        \dispatchNested commands\[cmdName] @[cmdName] parsed\params parsed globalSpec
    ]
]!
