;==========================================================
; Base template type
;==========================================================

define :climaxTemplate [
    ;---------------------------
    ; Style primitives
    ;---------------------------

    styleApp:     method [s :string] -> s
    styleSection: method [s :string] -> s
    styleFlag:    method [s :string] -> s
    styleArg:     method [s :string] -> s
    styleCommand: method [s :string] -> s
    styleDim:     method [s :string] -> s

    ;---------------------------
    ; Layout primitives
    ;---------------------------

    indent:          method [] -> "    "
    flagColWidth:    method [] -> 28
    commandColWidth: method [] -> 12

    ;---------------------------
    ; Section titles
    ;---------------------------

    headerUsage:         method [] -> "USAGE"
    headerOptions:       method [] -> "OPTIONS"
    headerGlobalOptions: method [] -> "GLOBAL OPTIONS"
    headerCommands:      method [] -> "COMMANDS"

    ;---------------------------
    ; Inline strings
    ;---------------------------

    tipText: method [label :string] ->
        ~"Run `|label| <command> --help` for command-specific help."

    titleSeparator: method [] -> "—"

    defaultLabel: method [val :string] -> ~" (default: |val|)"

    ;---------------------------
    ; Structural pieces
    ;---------------------------

    argSig: method [args :block][
        join.with:" " map args 'a [
            token: (a\required)? -> ~"<|a\name|>" -> ~"[<|a\name|>]"
            \styleArg token
        ]
    ]

    optionLine: method [entry :dictionary][
        line: pad.right (\styleFlag entry\flag) \flagColWidth
        line: line ++ entry\info
        unless null? entry\default [
            line: line ++ \styleDim \defaultLabel entry\default
        ]
        print \indent ++ line
    ]

    optionsSection: method [title :string  entries :block][
        unless empty? entries [
            print \styleSection title
            loop entries 'e -> 
                \optionLine e
            print ""
        ]
    ]

    subcommandList: method [subs :block][
        unless empty? subs [
            print \styleSection \headerCommands
            loop subs 'e [
                name: \styleCommand pad.right e\name \commandColWidth
                print \indent ++ name ++ e\info
            ]
            print ""
        ]
    ]

    usageLine: method [label :string  data :dictionary][
        hasSubs?:    not? empty? data\subcommands
        hasDefault?: not? null? data\defaultArgs
        styledLabel: \styleApp label

        ind: \indent
        (hasDefault?)? [
            sig: \argSig data\defaultArgs
            print (hasSubs?)? -> ~"|ind||styledLabel| [OPTIONS] (<command> [ARGS] | |sig|)"
                              -> ~"|ind||styledLabel| [OPTIONS] |sig|"
        ][
            print ~"|ind||styledLabel| [OPTIONS] <command> [ARGS]"
        ]
    ]

    ;---------------------------
    ; Render entry points
    ;---------------------------

    renderRoot: method [data :dictionary][
        print [\styleApp data\appName \titleSeparator data\appDesc]
        print ""

        print \styleSection \headerUsage
        \usageLine data\appName data
        print ""

        unless null? data\defaultOptions ->
            \optionsSection \headerOptions data\defaultOptions

        \optionsSection \headerGlobalOptions data\globalOptions
        \subcommandList data\subcommands

        unless empty? data\subcommands [
            tip: \tipText data\appName
            unless empty? tip -> print \styleDim tip
        ]
    ]

    renderGroup: method [data :dictionary][
        label: data\pathLabel

        print [\styleApp label \titleSeparator data\info]
        print ""

        print \styleSection \headerUsage
        \usageLine label data
        print ""

        \optionsSection \headerOptions       data\options
        \optionsSection \headerGlobalOptions data\globalOptions
        \subcommandList data\subcommands

        unless empty? data\subcommands [
            tip: \tipText label
            unless empty? tip -> print \styleDim tip
        ]
    ]

    renderCommand: method [data :dictionary][
        label: data\pathLabel
        sig:   \argSig data\args

        print [\styleApp label \titleSeparator data\info]
        print ""

        print \styleSection \headerUsage
        styledLabel: \styleApp label
        ind: \indent
        print ~"|ind||styledLabel| [OPTIONS] |sig|"
        print ""

        \optionsSection \headerOptions       data\options
        \optionsSection \headerGlobalOptions data\globalOptions
    ]
]
