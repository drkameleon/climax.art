;===============================================
; webforge.art
;
; Fictional static-site-generator CLI built with
; Climax. Covers global flags, typed options,
; optional + required positionals, and `--` rest
; args.
;
; Try:
;   arturo example/webforge.art --help
;   arturo example/webforge.art build mysite
;   arturo example/webforge.art serve mysite --watch -p 9000
;   arturo example/webforge.art deploy --clean mysite production
;   arturo example/webforge.art tag mysite -- --raw extra
;===============================================

;; name: webforge
;; description: « stupid simple static site generator
;; version: 1.0.0
;; author: drkameleon

import ./"../src/climax.art"!

climax .with: [
    verbose? 'v "verbose output"
    quiet?   'q "suppress all output"
] [
    build: command "build the site" [
        path :string :null
    ][
        root: path ?? "."
        if opts\verbose? -> print ~"[verbose] starting build in |root|"
        print ~"BUILD → compiling |root|/src into |root|/build"
    ]

    serve: command "build and run a local server" [
        path :string :null
    ] .with: [
        watch?                          "rebuild on source changes"
        port 'p 8080        :integer    "port number"
        host    "localhost" :string     "bind host"
    ][
        root: path ?? "."
        if opts\verbose? -> print ~"[verbose] preparing server for |root|"
        print ~"SERVE → http://|opts\host|:|opts\port|  (root: |root|)"
        if opts\watch? -> print "       watching source for changes..."
    ]

    deploy: command "deploy build folder via rsync or GitHub Pages" [
        path   :string :null
        target :string
    ] .with: [
        clean?  "wipe remote before syncing (DANGEROUS)"
    ][
        root: path ?? "."
        switch opts\clean? [
            print ~"DEPLOY → CLEAN sync of |root| to |target|"
        ][
            print ~"DEPLOY → incremental sync of |root| to |target|"
        ]
    ]

    tag: command "tag a release; raw args after `--` forwarded to git" [
        path :string :null
    ][
        root: path ?? "."
        print ~"TAG → creating release tag in |root|"
        unless empty? rest ->
            print ["       extra git args:" rest]
    ]

    clean: command "remove the build directory" [
        path :string :null
    ][
        root: path ?? "."
        print ~"CLEAN → removing |root|/build"
    ]
]
