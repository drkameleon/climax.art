;===============================================
; End-to-end CLI tests
;===============================================

import'unitt!

;---------------------------
; Helpers
;---------------------------

fixture:    ./"./partials/app.art"
flagsOnly:  ./"./partials/flagsonly.art"
withDef:    ./"./partials/withdefault.art"
plainApp:   ./"./partials/plain_app.art"
customApp:  ./"./partials/custom_tpl_app.art"

runApp: function [argLine :string][
    cmd: ~{|sys\binary| "|fixture|" |argLine|}
    return strip execute cmd
]

runFlagsOnly: function [argLine :string][
    cmd: ~{|sys\binary| "|flagsOnly|" |argLine|}
    return strip execute cmd
]

runWithDefault: function [argLine :string][
    cmd: ~{|sys\binary| "|withDef|" |argLine|}
    return strip execute cmd
]

runPlain: function [argLine :string][
    cmd: ~{|sys\binary| "|plainApp|" |argLine|}
    return strip execute cmd
]

runCustom: function [argLine :string][
    cmd: ~{|sys\binary| "|customApp|" |argLine|}
    return strip execute cmd
]

esc: to :string to :char 27

;---------------------------
; Tests
;---------------------------

suite "climax CLI" [

    test "--version prints script version" [
        out: runApp "--version"
        assert -> out = "0.0.1"
    ]

    test "no args prints help (contains COMMANDS section)" [
        out: runApp ""
        assert -> contains? out "COMMANDS"
        assert -> contains? out "hello"
        assert -> contains? out "add"
        assert -> contains? out "show"
        assert -> contains? out "rests"
    ]

    test "--help renders the global help screen" [
        out: runApp "--help"
        assert -> contains? out "GLOBAL OPTIONS"
        assert -> contains? out "--verbose"
    ]

    test "<cmd> --help renders per-command help" [
        out: runApp "show --help"
        assert -> contains? out "show"
        assert -> contains? out "--port"
        assert -> contains? out "--flag"
        assert -> contains? out "default: 8080"
    ]

    test "default positional fallback works" [
        out: runApp "hello"
        assert -> out = "hello world"
    ]

    test "positional arg is passed through" [
        out: runApp "hello alice"
        assert -> out = "hello alice"
    ]

    test "global flag visible inside command body" [
        out: runApp "-v hello"
        assert -> contains? out "[verbose] hello path"
        assert -> contains? out "hello world"
    ]

    test "typed positionals get coerced" [
        out: runApp "add 3 4"
        assert -> out = "7"
    ]

    test "options defaults appear when none provided" [
        out: runApp "show"
        assert -> out = "verbose=false port=8080 flag=false"
    ]

    test "CLI options override defaults; alias works" [
        out: runApp "show -p:9000 --flag"
        assert -> out = "verbose=false port=9000 flag=true"
    ]

    test "space-separated value: long flag" [
        out: runApp "show --port 9000 --flag"
        assert -> out = "verbose=false port=9000 flag=true"
    ]

    test "space-separated value: short alias" [
        out: runApp "show -p 9000 --flag"
        assert -> out = "verbose=false port=9000 flag=true"
    ]

    test "global flag merges into command opts" [
        out: runApp "-v show"
        assert -> out = "verbose=true port=8080 flag=false"
    ]

    test "rest args after -- captured" [
        out: runApp "rests x -- a b c"
        ls: split.lines out
        assert -> ls\0 = "head=x"
        assert -> contains? ls\1 "[a b c]"
    ]

    test "unknown command falls back to help" [
        out: runApp "totally-unknown"
        assert -> contains? out "USAGE"
        assert -> contains? out "COMMANDS"
    ]

    test "missing required positional errors cleanly" [
        out: runApp "add"
        assert -> contains? out "missing required argument"
        assert -> contains? out "add"
        assert -> contains? out "<a>"
        assert -> contains? out "<b>"
    ]

    test "supplying required positionals works" [
        out: runApp "add 3 4"
        assert -> out = "7"
    ]

    test "optional positional may be omitted" [
        out: runApp "hello"
        assert -> out = "hello world"
    ]

    test "command help shows required vs optional" [
        out: runApp "add --help"
        assert -> contains? out "<a>"
        assert -> contains? out "<b>"
        out2: runApp "hello --help"
        assert -> contains? out2 "[<who>]"
    ]

    test "nested: root help lists group as command" [
        out: runApp ""
        assert -> contains? out "remote"
    ]

    test "nested: group --help shows sub-commands" [
        out: runApp "remote --help"
        assert -> contains? out "COMMANDS"
        assert -> contains? out "add"
        assert -> contains? out "rm"
        assert -> contains? out "--loud"
    ]

    test "nested: bare group prints group help" [
        out: runApp "remote"
        assert -> contains? out "add"
        assert -> contains? out "rm"
    ]

    test "nested: leaf executes via group path" [
        out: runApp "remote add origin https://example"
        assert -> contains? out "adding origin https://example"
    ]

    test "nested: leaf --help shows leaf signature" [
        out: runApp "remote add --help"
        assert -> contains? out "<name>"
        assert -> contains? out "<url>"
        assert -> contains? out "remote add"
    ]

    test "nested: missing required positional in leaf" [
        out: runApp "remote add"
        assert -> contains? out "missing required argument"
        assert -> contains? out "remote add"
        assert -> contains? out "<name>"
        assert -> contains? out "<url>"
    ]

    test "nested: unknown sub-command reports error" [
        out: runApp "remote bogus"
        assert -> contains? out "unknown sub-command"
    ]

    test "nested: group's persistent option visible in leaf body" [
        out: runApp "remote --loud add origin https://example"
        assert -> contains? out "loud=true"
    ]

    test "nested: root global flag visible in nested leaf body" [
        out: runApp "-v remote add origin https://example"
        assert -> contains? out "verbose=true"
    ]

    test "nested: persistent flag accepted after leaf name too" [
        out: runApp "remote add --loud origin https://example"
        assert -> contains? out "loud=true"
    ]
]

suite "climax default: flag-only" [

    test "bare invocation with positional runs default" [
        out: runFlagsOnly "example.com"
        assert -> contains? out "hello example.com"
        assert -> contains? out "verbose=false"
    ]

    test "option flag passed to default" [
        out: runFlagsOnly "-c:3 example.com"
        assert -> contains? out "#1"
        assert -> contains? out "#2"
        assert -> contains? out "#3"
    ]

    test "global flag visible inside default body" [
        out: runFlagsOnly "-v example.com"
        assert -> contains? out "verbose=true"
    ]

    test "--help shows default's USAGE signature, no COMMANDS section" [
        out: runFlagsOnly "--help"
        assert -> contains? out "<host>"
        assert -> contains? out "--count"
        assert -> not? contains? out "COMMANDS"
    ]

    test "--version still works in flag-only mode" [
        out: runFlagsOnly "--version"
        assert -> out = "0.0.1"
    ]

    test "missing required positional reports cleanly" [
        out: runFlagsOnly ""
        assert -> contains? out "missing required argument"
        assert -> contains? out "<host>"
    ]
]

suite "climax default: alongside named commands" [

    test "bare invocation runs root default" [
        out: runWithDefault ""
        assert -> contains? out "status: nominal"
    ]

    test "named command still dispatches" [
        out: runWithDefault "restart"
        assert -> contains? out "restarting..."
    ]

    test "root help lists named commands but not 'default'" [
        out: runWithDefault "--help"
        assert -> contains? out "restart"
        assert -> contains? out "remote"
        assert -> not? contains? out "  default"
    ]

    test "group with default: bare group runs group default" [
        out: runWithDefault "remote"
        assert -> contains? out "origin"
        assert -> contains? out "upstream"
    ]

    test "group with default: named sub still dispatches" [
        out: runWithDefault "remote add origin https://x"
        assert -> contains? out "added origin https://x"
    ]

    test "group with default: unknown token falls through to default" [
        out: runWithDefault "remote --help"
        assert -> contains? out "COMMANDS"
        assert -> contains? out "add"
        assert -> not? contains? out "  default"
    ]
]

suite "help templates" [

    test "default template emits ANSI escapes" [
        out: runApp "--help"
        assert -> contains? out esc
    ]

    test "default template colours section headings" [
        out: runApp "--help"
        ;; bold cyan ANSI prefix
        assert -> contains? out (esc ++ "[1;36m")
    ]

    test ".template: 'plain emits no ANSI escapes" [
        out: runPlain "--help"
        assert -> not? contains? out esc
    ]

    test ".template: 'plain still renders standard sections" [
        out: runPlain "--help"
        assert -> contains? out "USAGE"
        assert -> contains? out "COMMANDS"
        assert -> contains? out "hello"
    ]

    test ".template: 'plain body output unaffected" [
        out: runPlain "hello alice"
        assert -> out = "hello alice"
    ]

    test "user-defined template selected by literal name" [
        out: runCustom "--help"
        assert -> contains? out "::CUSTOM-TEMPLATE::"
        assert -> contains? out "customapp"
        assert -> contains? out "::END::"
    ]

    test "user-defined template doesn't disturb command dispatch" [
        out: runCustom "hello"
        assert -> out = "hi"
    ]
]

unitt\report 'full
