import'unitt!
import ./"../src/climax.art"!

commands: ["serve" "greet" "init"]

suite ":cli" [

    test "no arguments" [
        assert -> (to :dictionary to :cli .using: "" @[commands]) = #[
            globals:    #[]
            command:    null
            options:    #[]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "subcommand only" [
        assert -> (to :dictionary to :cli .using: "serve" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]

        assert -> (to :dictionary to :cli .using: "init" @[commands]) = #[
            globals:    #[]
            command:    "init"
            options:    #[]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "global flags only" [
        assert -> (to :dictionary to :cli .using: "--verbose --debug" @[commands]) = #[
            globals:    #[verbose: true debug: true]
            command:    null
            options:    #[]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "global flags + subcommand + command flags + positional" [
        assert -> (to :dictionary to :cli .using: "--verbose serve --port:8080 --host=localhost app.conf" @[commands]) = #[
            globals:    #[verbose: true]
            command:    "serve"
            options:    #[port: 8080 host: "localhost"]
            params:     ["app.conf"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "boolean + valued flags mixed" [
        assert -> (to :dictionary to :cli .using: "--verbose --config:myfile.toml serve --dry-run --port:3000" @[commands]) = #[
            globals:    #[verbose: true config: "myfile.toml"]
            command:    "serve"
            options:    #["dry-run": true port: 3000]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "subcommand with flags and positionals" [
        assert -> (to :dictionary to :cli .using: "greet John Doe" @[commands]) = #[
            globals:    #[]
            command:    "greet"
            options:    #[]
            params:     ["John" "Doe"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]

        assert -> (to :dictionary to :cli .using: "init --bare myproject" @[commands]) = #[
            globals:    #[]
            command:    "init"
            options:    #[bare: true]
            params:     ["myproject"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "short flags" [
        assert -> (to :dictionary to :cli .using: "-v serve -p:8080 -h=localhost" @[commands]) = #[
            globals:    #[v: true]
            command:    "serve"
            options:    #[p: 8080 h: "localhost"]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "-- separator with raw args" [
        assert -> (to :dictionary to :cli .using: "serve --port:8080 app.conf -- --raw-thing -x foo" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: 8080]
            params:     ["app.conf"]
            rest:       ["--raw-thing" "-x" "foo"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "multiple -- in rest" [
        assert -> (to :dictionary to :cli .using: "serve -- --foo -- --bar" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[]
            params:     []
            rest:       ["--foo" "--" "--bar"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "-- with nothing after" [
        assert -> (to :dictionary to :cli .using: "serve --port:8080 --" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: 8080]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "only rest args" [
        assert -> (to :dictionary to :cli .using: "-- --foo --bar baz" @[commands]) = #[
            globals:    #[]
            command:    null
            options:    #[]
            params:     []
            rest:       ["--foo" "--bar" "baz"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "global + subcommand + positional + rest" [
        assert -> (to :dictionary to :cli .using: "--verbose init myproject -- --template=basic" @[commands]) = #[
            globals:    #[verbose: true]
            command:    "init"
            options:    #[]
            params:     ["myproject"]
            rest:       ["--template=basic"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "subcommand + rest only" [
        assert -> (to :dictionary to :cli .using: "greet -- surplus" @[commands]) = #[
            globals:    #[]
            command:    "greet"
            options:    #[]
            params:     []
            rest:       ["surplus"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "flag right before --" [
        assert -> (to :dictionary to :cli .using: "serve --port:8080 --debug -- leftover" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: 8080 debug: true]
            params:     []
            rest:       ["leftover"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "global flags + rest, no subcommand" [
        assert -> (to :dictionary to :cli .using: "--verbose -- --leftover" @[commands]) = #[
            globals:    #[verbose: true]
            command:    null
            options:    #[]
            params:     []
            rest:       ["--leftover"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "positional before subcommand" [
        assert -> (to :dictionary to :cli .using: "somefile.txt serve --port:8080" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: 8080]
            params:     ["somefile.txt"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "no known subcommand" [
        assert -> (to :dictionary to :cli .using: "--verbose unknown-thing file1.txt file2.txt" @[commands]) = #[
            globals:    #[verbose: true]
            command:    null
            options:    #[]
            params:     ["unknown-thing" "file1.txt" "file2.txt"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "URL value with colons via =" [
        assert -> (to :dictionary to :cli .using: "serve --url=http://localhost:3000/api" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[url: "http://localhost:3000/api"]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "flag value via colon" [
        assert -> (to :dictionary to :cli .using: "serve --name:hello" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[name: "hello"]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "double-dash value" [
        assert -> (to :dictionary to :cli .using: "serve --name=--weird" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[name: "--weird"]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "special chars in value" [
        assert -> (to :dictionary to :cli .using: "serve --regex:^[a-z]+d{3}$" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[regex: "^[a-z]+d{3}$"]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "empty flag values" [
        assert -> (to :dictionary to :cli .using: "serve --name: --port=" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[name: "" port: ""]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]

        assert -> (to :dictionary to :cli .using: "serve --name= file.txt" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[name: ""]
            params:     ["file.txt"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "interspersed flags and positionals" [
        assert -> (to :dictionary to :cli .using: "serve --port:8080 file1.txt --debug file2.txt file3.txt" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: 8080 debug: true]
            params:     ["file1.txt" "file2.txt" "file3.txt"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "repeated flag (last wins)" [
        assert -> (to :dictionary to :cli .using: "serve --port:8080 --port:9090" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: 9090]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "lone dash as stdin" [
        assert -> (to :dictionary to :cli .using: "serve - input.txt" @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[]
            params:     ["-" "input.txt"]
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "negative numbers parsed as flags" [
        assert -> (to :dictionary to :cli .using: "greet --times:3 -42" @[commands]) = #[
            globals:    #[]
            command:    "greet"
            options:    #[times: 3 "42": true]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "numeric flag name" [
        assert -> (to :dictionary to :cli .using: "--123:hello serve" @[commands]) = #[
            globals:    #["123": "hello"]
            command:    "serve"
            options:    #[]
            params:     []
            rest:       []
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "all sections heavily populated" [
        assert -> (to :dictionary to :cli .using: "--verbose --debug --config:app.toml serve --port:8080 --host:0.0.0.0 --workers:4 --ssl app.conf keys.pem -- --extra1 --extra2 val" @[commands]) = #[
            globals:    #[verbose: true debug: true config: "app.toml"]
            command:    "serve"
            options:    #[port: 8080 host: "0.0.0.0" workers: 4 ssl: true]
            params:     ["app.conf" "keys.pem"]
            rest:       ["--extra1" "--extra2" "val"]
            valueOpts:  []
            predicateAliases: []
        ]
    ]

    test "space-separated value: long flag" [
        assert -> (to :dictionary to :cli .using: "serve --port 8080" .valueOpts: ["port"] @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: 8080]
            params:     []
            rest:       []
            valueOpts:  ["port"]
            predicateAliases: []
        ]
    ]

    test "space-separated value: short flag" [
        assert -> (to :dictionary to :cli .using: "serve -p 9000" .valueOpts: ["port" "p"] @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[p: 9000]
            params:     []
            rest:       []
            valueOpts:  ["port" "p"]
            predicateAliases: []
        ]
    ]

    test "space-separated value: string value preserved" [
        assert -> (to :dictionary to :cli .using: "serve --host localhost app.conf" .valueOpts: ["host"] @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[host: "localhost"]
            params:     ["app.conf"]
            rest:       []
            valueOpts:  ["host"]
            predicateAliases: []
        ]
    ]

    test "space-separated: flag not in valueOpts stays boolean" [
        assert -> (to :dictionary to :cli .using: "serve --dry-run app.conf" .valueOpts: ["port"] @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #["dry-run": true]
            params:     ["app.conf"]
            rest:       []
            valueOpts:  ["port"]
            predicateAliases: []
        ]
    ]

    test "space-separated: don't consume the next flag as a value" [
        assert -> (to :dictionary to :cli .using: "serve --port --verbose" .valueOpts: ["port" "verbose"] @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: true verbose: true]
            params:     []
            rest:       []
            valueOpts:  ["port" "verbose"]
            predicateAliases: []
        ]
    ]

    test "space-separated: trailing bare flag stays boolean" [
        assert -> (to :dictionary to :cli .using: "serve --port" .valueOpts: ["port"] @[commands]) = #[
            globals:    #[]
            command:    "serve"
            options:    #[port: true]
            params:     []
            rest:       []
            valueOpts:  ["port"]
            predicateAliases: []
        ]
    ]
]

unitt\report 'full