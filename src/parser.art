parseArgs: function [knownCommands :block][
    result: #[
        globals: #[]
        command: null
        options: #[]
        params:  []
        rest:    []
    ]

    tokens: arg
    i: 0
    foundCommand?: false

    parseFlag: function [token :string][
        clean: token
        (prefix? clean "--")? -> clean: slice clean 2 (dec size clean)
                              -> clean: slice clean 1 (dec size clean)

        idxColon: index clean ":"
        idxEqual: index clean "="

        sep: null
        if and? [null? idxColon][null? idxEqual] -> return #[name: clean value: true]

        if null? idxColon -> sep: idxEqual
        if null? idxEqual -> sep: idxColon
        if null? sep      -> sep: min @[idxColon idxEqual]

        return #[
            name:  slice clean 0 (dec sep)
            value: slice clean (inc sep) (dec size clean)
        ]
    ]

    while [i < size tokens][
        token: tokens\[i]

        case token [
            "--" [
                i: i + 1
                while [i < size tokens][
                    'result\rest ++ tokens\[i]
                    i: i + 1
                ]
            ]
            any [
                (and? [prefix? token "-"][token <> "-"])? [
                    flag: parseFlag token
                    val: flag\value
                    if string? val [
                        if numeric? val -> val: to :integer val
                    ]
                    (foundCommand?)?
                        -> result\options\[flag\name]: val
                        -> result\globals\[flag\name]: val
                ][
                    if and? [not? foundCommand?][in? token knownCommands][
                        result\command: token
                        foundCommand?: true
                    ]
                    if or? [foundCommand?][not? in? token knownCommands]
                        -> if token <> result\command
                            -> 'result\params ++ token
                ]
            ]
        ]

        i: i + 1
    ]

    return result
]